{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/mathcert_handoff.schema.json",
  "title": "MATHSOLVE to MATHCERT handoff packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "campaign_id", "solve_work_package_id", "source_commit", "target_claims", "claim_ledger", "proof_obligations", "checker_contract", "status", "reopening_conditions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "handoff_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
    "solve_work_package_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_claims": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim_id", "statement", "claim_type", "support_type"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "claim_type": {"type": "string", "minLength": 1},
          "support_type": {"type": "string", "minLength": 1}
        }
      }
    },
    "claim_ledger": {"$ref": "campaign_manifest.schema.json#/$defs/artifact_ref"},
    "proof_obligations": {"$ref": "campaign_manifest.schema.json#/$defs/artifact_ref"},
    "checker_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "inputs", "acceptance", "rejection"],
      "properties": {
        "target": {"enum": ["Lean", "Coq", "SAT", "SMT", "PB", "CAS", "interval", "human_audit", "other"]},
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "acceptance": {"type": "string", "minLength": 1},
        "rejection": {"type": "string", "minLength": 1}
      }
    },
    "status": {"enum": ["pending", "ready", "submitted", "certified", "qualified", "rejected", "proof_debt"]},
    "reopening_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
