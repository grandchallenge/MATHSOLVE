      "properties": {
        "result_family_only": {"const": true},
        "may_create_aggregate_handoff": {"const": false},
        "may_imply_mathcert_acceptance": {"const": false},
        "may_imply_adjudication": {"const": false},
        "may_claim_mathematical_proof": {"const": false},
        "may_promote_claim": {"const": false},
        "may_route_circuit_theorem": {"const": false},
        "may_route_gate_bounds": {"const": false},
        "may_route_total_size_consequences": {"const": false}
      }
