              "properties": {
                "source_theorem": {"const": "Theorem 1.3"},
                "variable_leaf_constant": {"const": 192},
                "source_gate_constant": {"const": 384},
                "encoded_variable_leaf_bound": {"const": true},
                "encoded_gate_bound": {"const": false},
                "encoded_total_leaves_vertices": {"const": false}
              }
            },
            "historical_pdf_byte_equivalence": {"const": false}
          }
        },
        "lean_theorems": {
          "type": "array", "prefixItems": [
            {"const": "PermanentFormulaLowerBound.permanent_divisionFree_formula_logarithmic_lower_bound"},
            {"const": "PermanentFormulaLowerBound.permanent_rational_formula_logarithmic_lower_bound"}
          ], "items": false, "minItems": 2, "maxItems": 2
        },
        "nonvacuity_witnesses": {
          "type": "array", "prefixItems": [
            {"const": "PermanentFormulaLowerBound.Nonvacuity.permanent_divisionFree_formula_nonvacuous"},
            {"const": "PermanentFormulaLowerBound.Nonvacuity.permanent_rational_formula_nonvacuous"}
          ], "items": false, "minItems": 2, "maxItems": 2
        },
        "scope_exclusions": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 50}}
