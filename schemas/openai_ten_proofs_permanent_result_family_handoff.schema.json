        "commit_sha": {"const": "60f6e06c957139447bf5943eed731941b22ac608"},
        "path": {"type": "string", "minLength": 20},
        "digest_algorithm": {"const": "git_blob_sha1"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
