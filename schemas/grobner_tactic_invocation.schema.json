{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/mathsolve-grobner-tactic-invocation.schema.json",
  "title": "MATHSOLVE Groebner Tactic Invocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invocation_id",
    "schema_version",
    "parent_problem",
    "local_obligation",
    "local_scope_justification",
    "global_open_problem_encoding",
    "algebraic_task",
    "coefficient_domain",
    "variables",
    "side_conditions",
    "resource_budget",
    "fallback_route",
    "expected_witness",
    "status",
    "witness_source",
    "handoff",
    "failure_record",
    "notes"
  ],
  "properties": {
    "invocation_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$"},
    "schema_version": {"const": "0.2.0"},
    "parent_problem": {"type": "string", "minLength": 1},
    "local_obligation": {"type": "string", "minLength": 1},
    "local_scope_justification": {"type": "string", "minLength": 20},
    "global_open_problem_encoding": {"const": false},
    "algebraic_task": {
      "enum": [
        "polynomial_identity",
        "normal_form",
        "ideal_membership",
        "ideal_nonmembership",
        "ideal_equality",
        "grobner_basis_check",
        "radical_membership",
        "elimination",
        "branch_pruning",
        "finite_truncation",
        "tropical_initial_ideal"
      ]
    },
    "coefficient_domain": {"type": "string", "minLength": 1},
    "variables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["universe", "names", "variable_count"],
      "properties": {
        "universe": {"enum": ["finite", "finite_truncation"]},
        "names": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "variable_count": {"type": "integer", "minimum": 1}
      }
    },
    "side_conditions": {"type": "array", "items": {"type": "string"}},
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_variables", "max_total_degree", "timeout_seconds", "max_basis_polynomials", "max_intermediate_terms"],
      "properties": {
        "max_variables": {"type": "integer", "minimum": 1},
        "max_total_degree": {"type": "integer", "minimum": 0},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "max_basis_polynomials": {"type": "integer", "minimum": 1},
        "max_intermediate_terms": {"type": "integer", "minimum": 1}
      }
    },
    "fallback_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "trigger_conditions", "rationale"],
      "properties": {
        "route_id": {"type": "string", "minLength": 1},
        "trigger_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "rationale": {"type": "string", "minLength": 10}
      }
    },
    "expected_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_preference", "certification_obligation"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "source_preference": {"enum": ["MATHFORGE", "existing_content_addressed_witness", "direct_exact_derivation"]},
        "certification_obligation": {"type": "string", "minLength": 15}
      }
    },
    "status": {
      "enum": [
        "candidate",
        "witness_requested",
        "witness_available",
        "ready_for_mathcert",
        "submitted",
        "certified",
        "qualified",
        "rejected",
        "proof_debt"
      ]
    },
    "witness_source": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit_sha", "path", "digest_algorithm", "digest"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "path": {"type": "string", "minLength": 1},
            "digest_algorithm": {"const": "git_blob_sha1"},
            "digest": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        }
      ]
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_repository",
        "target_certificate_kind",
        "target_schema",
        "expected_trust_boundary",
        "intake_acknowledgement",
        "mathcert_output"
      ],
      "properties": {
        "target_repository": {"const": "grandchallenge/MATHCERT"},
        "target_certificate_kind": {"type": "string", "minLength": 1},
        "target_schema": {"type": "string", "minLength": 1},
        "expected_trust_boundary": {"enum": ["exact_replay", "lean_kernel_checked", "qualified_human_audit"]},
        "intake_acknowledgement": {"type": ["string", "null"]},
        "mathcert_output": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "commit_sha", "path", "digest_algorithm", "digest", "disposition"],
              "properties": {
                "repository": {"const": "grandchallenge/MATHCERT"},
                "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "path": {"type": "string", "minLength": 1},
                "digest_algorithm": {"const": "git_blob_sha1"},
                "digest": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "disposition": {"enum": ["certified", "qualified", "rejected", "proof_debt"]}
              }
            }
          ]
        }
      }
    },
    "failure_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "entries"],
      "properties": {
        "status": {"enum": ["none", "recorded"]},
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["failure_id", "reason", "fallback_taken"],
            "properties": {
              "failure_id": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1},
              "fallback_taken": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "notes": {"type": "string", "minLength": 1}
  }
}
