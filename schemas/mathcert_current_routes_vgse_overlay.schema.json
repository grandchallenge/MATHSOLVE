{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/mathcert_current_routes_vgse_overlay.schema.json",
  "title": "VGSE current MATHCERT route successor overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "overlay_id",
    "recorded_at",
    "base_registry",
    "current_authority",
    "campaign"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "overlay_id": {
      "const": "MS-MATHCERT-CURRENT-VGSE-001"
    },
    "recorded_at": {
      "type": "string",
      "format": "date"
    },
    "base_registry": {
      "$ref": "#/$defs/local_ref"
    },
    "current_authority": {
      "$ref": "#/$defs/authority_ref"
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "route_id",
        "route_registry_entry_present",
        "manifest",
        "handoff",
        "handoff_state",
        "route_state",
        "cert_output",
        "qualification_scope",
        "mathematical_target_proved",
        "may_adjudicate",
        "may_issue_certificate_output",
        "current_promotion_blockers"
      ],
      "properties": {
        "campaign_id": {
          "const": "VGSE-001"
        },
        "route_id": {
          "const": "MC-ROUTE-VGSE-001"
        },
        "route_registry_entry_present": {
          "const": false
        },
        "manifest": {
          "$ref": "#/$defs/local_ref"
        },
        "handoff": {
          "$ref": "#/$defs/local_ref"
        },
        "handoff_state": {
          "const": "pending"
        },
        "route_state": {
          "const": "pending"
        },
        "cert_output": {
          "type": "null"
        },
        "qualification_scope": {
          "type": "null"
        },
        "mathematical_target_proved": {
          "const": false
        },
        "may_adjudicate": {
          "const": false
        },
        "may_issue_certificate_output": {
          "const": false
        },
        "current_promotion_blockers": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  },
  "$defs": {
    "local_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest_algorithm",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 5
        },
        "digest_algorithm": {
          "const": "git_blob_sha1"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "authority_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit_sha",
        "path",
        "digest_algorithm",
        "digest"
      ],
      "properties": {
        "repository": {
          "const": "grandchallenge/MATHCERT"
        },
        "commit_sha": {
          "const": "64e042ddb1147338ad7868a2847715fe7c1c079d"
        },
        "path": {
          "const": "governance/certification_routes.json"
        },
        "digest_algorithm": {
          "const": "git_blob_sha1"
        },
        "digest": {
          "const": "cf876f43ae824f965a3aedf411671c110c380028"
        }
      }
    }
  }
}
