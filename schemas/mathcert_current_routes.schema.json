{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/mathcert_current_routes.schema.json",
  "title": "Current MATHCERT route and adjudication overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "verified_at",
    "authority",
    "state_semantics",
    "campaigns"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"const": "MS-MATHCERT-CURRENT-001"},
    "verified_at": {"type": "string", "format": "date"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha", "path", "digest_algorithm", "digest"],
      "properties": {
        "repository": {"const": "grandchallenge/MATHCERT"},
        "commit_sha": {"const": "64e042ddb1147338ad7868a2847715fe7c1c079d"},
        "path": {"const": "governance/certification_routes.json"},
        "digest_algorithm": {"const": "git_blob_sha1"},
        "digest": {"const": "cf876f43ae824f965a3aedf411671c110c380028"}
      }
    },
    "state_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_handoff_status_is_immutable",
        "route_state_is_current_adjudication",
        "judgment_gate_uses",
        "promotion_requires"
      ],
      "properties": {
        "producer_handoff_status_is_immutable": {"const": true},
        "route_state_is_current_adjudication": {"const": true},
        "judgment_gate_uses": {"const": "route_state"},
        "promotion_requires": {
          "type": "array",
          "prefixItems": [
            {"const": "positive_route_state"},
            {"const": "manifest_promotion_eligible"}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "campaigns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "UC-001",
        "NS-CI-001",
        "HC-001",
        "BSD-001",
        "PNP-001",
        "RH-001",
        "YM-001",
        "OZ-001"
      ],
      "properties": {
        "UC-001": {"$ref": "#/$defs/routeRecord"},
        "NS-CI-001": {"$ref": "#/$defs/routeRecord"},
        "HC-001": {"$ref": "#/$defs/routeRecord"},
        "BSD-001": {"$ref": "#/$defs/routeRecord"},
        "PNP-001": {"$ref": "#/$defs/routeRecord"},
        "RH-001": {"$ref": "#/$defs/routeRecord"},
        "YM-001": {"$ref": "#/$defs/routeRecord"},
        "OZ-001": {"$ref": "#/$defs/routeRecord"}
      }
    }
  },
  "$defs": {
    "localArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest_algorithm", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest_algorithm": {"const": "git_blob_sha1"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "externalArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha", "path", "digest_algorithm", "digest"],
      "properties": {
        "repository": {"const": "grandchallenge/MATHCERT"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string", "minLength": 1},
        "digest_algorithm": {"const": "git_blob_sha1"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "routeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "manifest",
        "handoff",
        "handoff_state",
        "route_state",
        "cert_output",
        "qualification_scope",
        "mathematical_target_proved",
        "current_promotion_blockers"
      ],
      "properties": {
        "route_id": {"type": "string", "pattern": "^MC-ROUTE-[A-Z0-9-]+$"},
        "manifest": {"$ref": "#/$defs/localArtifact"},
        "handoff": {"$ref": "#/$defs/localArtifact"},
        "handoff_state": {
          "enum": ["pending", "ready", "submitted", "certified", "qualified", "rejected", "proof_debt"]
        },
        "route_state": {
          "enum": ["pending", "ready", "submitted", "certified", "qualified", "rejected", "proof_debt"]
        },
        "cert_output": {
          "oneOf": [
            {"$ref": "#/$defs/externalArtifact"},
            {"type": "null"}
          ]
        },
        "qualification_scope": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "mathematical_target_proved": {"const": false},
        "current_promotion_blockers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"route_state": {"enum": ["certified", "qualified"]}},
            "required": ["route_state"]
          },
          "then": {
            "properties": {
              "cert_output": {"$ref": "#/$defs/externalArtifact"},
              "qualification_scope": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"route_state": {"enum": ["pending", "ready", "submitted"]}},
            "required": ["route_state"]
          },
          "then": {
            "properties": {
              "cert_output": {"type": "null"},
              "qualification_scope": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
