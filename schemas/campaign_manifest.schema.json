{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/mathsolve_campaign_manifest.schema.json",
  "title": "MATHSOLVE recursive campaign manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_id", "campaign_id", "coverage_mode",
    "programme", "forge_inputs", "solve", "work_packages",
    "certification", "promotion", "disposal"
  ],
  "properties": {
    "schema_version": {"const": "1.2.0"},
    "manifest_id": {"type": "string", "pattern": "^MS-MANIFEST-[A-Z0-9-]+$"},
    "campaign_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
    "coverage_mode": {"enum": ["native", "retrospective"]},
    "programme": {"$ref": "#/$defs/repository_record"},
    "forge_inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_ref"}},
    "solve": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "provider_issue", "provider_commit", "migration_debt"],
      "properties": {
        "repository": {"const": "grandchallenge/MATHSOLVE"},
        "provider_issue": {"type": "string", "minLength": 1},
        "provider_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "migration_debt": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "work_packages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/work_package"}},
    "certification": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "contract", "handoff_state", "handoff_packets"],
      "properties": {
        "repository": {"const": "grandchallenge/MATHCERT"},
        "contract": {"$ref": "#/$defs/cert_contract_ref"},
        "handoff_state": {"enum": ["pending", "ready", "submitted", "certified", "qualified", "rejected", "proof_debt"]},
        "handoff_packets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/handoff_ref"}}
      }
    },
    "promotion": {
      "type": "object", "additionalProperties": false,
      "required": ["eligible", "blockers"],
      "properties": {
        "eligible": {"type": "boolean"},
        "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "disposal": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "supersedes", "reopening_conditions"],
      "properties": {
        "status": {"enum": ["active", "archived", "superseded", "terminated"]},
        "supersedes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reopening_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "repository_record": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "issue", "commit_sha"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "issue": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "cert_contract_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit_sha", "path", "digest_algorithm", "digest"],
      "properties": {
        "repository": {"const": "grandchallenge/MATHCERT"},
        "commit_sha": {"const": "3854dd1b4f6e162a7e74c3da1993f022ee691e5e"},
        "path": {"const": "governance/certification_routes.json"},
        "digest_algorithm": {"const": "git_blob_sha1"},
        "digest": {"const": "065f0531e4d763b389b207d4922d5a85b4335ee3"}
      }
    },
    "artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit_sha", "path", "digest_algorithm", "digest", "role"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string", "minLength": 1, "not": {"const": "."}},
        "digest_algorithm": {"enum": ["git_blob_sha1", "git_tree_sha1", "sha256"]},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$"},
        "role": {"enum": ["source", "programme_bundle", "solve_artifact", "claim_ledger", "proof_obligation_dag", "failed_route_ledger", "resource_ledger", "certificate_handoff", "review", "other"]}
      },
      "allOf": [
        {
          "if": {"properties": {"digest_algorithm": {"enum": ["git_blob_sha1", "git_tree_sha1"]}}, "required": ["digest_algorithm"]},
          "then": {"properties": {"digest": {"pattern": "^[0-9a-f]{40}$"}}}
        },
        {
          "if": {"properties": {"digest_algorithm": {"const": "sha256"}}, "required": ["digest_algorithm"]},
          "then": {"properties": {"digest": {"pattern": "^[0-9a-f]{64}$"}}}
        }
      ]
    },
    "handoff_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["handoff_id", "status", "target_claim_ids", "artifact"],
      "properties": {
        "handoff_id": {"type": "string", "pattern": "^MC-HANDOFF-[A-Z0-9-]+$"},
        "status": {"enum": ["pending", "ready", "submitted", "certified", "qualified", "rejected", "proof_debt"]},
        "target_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "artifact": {"$ref": "#/$defs/artifact_ref"}
      }
    },
    "ledger_set": {
      "type": "object", "additionalProperties": false,
      "required": ["claim", "proof_obligation"],
      "properties": {
        "claim": {"$ref": "#/$defs/artifact_ref"},
        "proof_obligation": {"$ref": "#/$defs/artifact_ref"},
        "failed_route": {"oneOf": [{"$ref": "#/$defs/artifact_ref"}, {"type": "null"}]},
        "resource": {"oneOf": [{"$ref": "#/$defs/artifact_ref"}, {"type": "null"}]},
        "certification": {"oneOf": [{"$ref": "#/$defs/artifact_ref"}, {"type": "null"}]}
      }
    },
    "work_package": {
      "type": "object", "additionalProperties": false,
      "required": ["work_package_id", "primary_type", "status", "source_repository", "source_commit", "artifacts", "ledgers", "children"],
      "properties": {
        "work_package_id": {"type": "string", "minLength": 1},
        "primary_type": {"enum": ["STATUS_SPINE", "LITERATURE_SYNTHESIS", "NORMAL_FORM_REDUCTION", "RESTRICTED_THEOREM", "NEGATIVE_RESULT", "EXACT_COMPUTATIONAL_SCREEN", "ALGEBRAIC_GEOMETRY_CAMPAIGN", "INTERVAL_CERTIFICATION_CAMPAIGN", "FORMALIZATION_HANDOFF", "COUNTEREXAMPLE_SEARCH", "PEDAGOGICAL_COMPANION", "GOVERNANCE_HANDOFF"]},
        "status": {"enum": ["open", "active", "complete", "blocked", "archived", "terminated"]},
        "source_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_ref"}},
        "ledgers": {"$ref": "#/$defs/ledger_set"},
        "children": {"type": "array", "items": {"$ref": "#/$defs/work_package"}}
      }
    }
  }
}
