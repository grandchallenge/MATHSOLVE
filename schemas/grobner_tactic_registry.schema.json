{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/mathsolve-grobner-tactic-registry.schema.json",
  "title": "MATHSOLVE Groebner Tactic Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "invocations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"const": "MS-GROEBNER-TACTIC-REGISTRY"},
    "invocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invocation_id", "path", "git_blob_sha1", "schema_path", "status"],
        "properties": {
          "invocation_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^examples/grobner_tactic_invocations/.+\\.json$"},
          "git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "schema_path": {"const": "schemas/grobner_tactic_invocation.schema.json"},
          "status": {
            "enum": [
              "candidate",
              "witness_requested",
              "witness_available",
              "ready_for_mathcert",
              "submitted",
              "certified",
              "qualified",
              "rejected",
              "proof_debt"
            ]
          }
        }
      }
    }
  }
}
