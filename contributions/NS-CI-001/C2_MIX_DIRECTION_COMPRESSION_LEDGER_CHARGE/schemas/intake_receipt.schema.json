{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/pilots/ns-ci-github-intake-receipt.schema.json",
  "title": "NS-CI GitHub contribution intake receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "dispatch_id",
    "assignment_id",
    "concurrency_mode",
    "result_protocol",
    "github_issue_number",
    "github_comment_id",
    "authenticated_github_actor",
    "comment_created_at",
    "raw_artifact_path",
    "raw_sha256",
    "bootstrap_path",
    "bootstrap_sha256",
    "source_handoff_commit_sha",
    "source_handoff_blob_sha",
    "source_handoff_sha256",
    "disposition_declared",
    "context_class_declared",
    "external_sources_declared",
    "timebox_observed_declared",
    "schema_result",
    "freshness",
    "security_state",
    "handling_state",
    "mathematical_correctness_adjudicated",
    "independence_strength_adjudicated",
    "canonical_claim_effect",
    "recorded_by"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2-pilot"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "dispatch_id": {
      "type": "string",
      "pattern": "^NSCI-C2-[A-E]-(BLIND|COOP|ADV)-[0-9]{3}$"
    },
    "assignment_id": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ]
    },
    "concurrency_mode": {
      "enum": [
        "independent_blind",
        "cooperative_claimed",
        "adversarial_replay"
      ]
    },
    "blind_cohort_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "result_protocol": {
      "const": "GCL-CONTRIBUTION-RESULT/1"
    },
    "github_issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "github_comment_id": {
      "type": "integer",
      "minimum": 1
    },
    "authenticated_github_actor": {
      "type": "string",
      "minLength": 1
    },
    "comment_created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_artifact_path": {
      "type": "string",
      "minLength": 1
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bootstrap_path": {
      "type": "string",
      "minLength": 1
    },
    "bootstrap_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_handoff_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_handoff_blob_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_handoff_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "disposition_declared": {
      "enum": [
        "PROVED",
        "REFUTED",
        "REDUCED",
        "BLOCKED"
      ]
    },
    "context_class_declared": {
      "const": "ZERO_CONTEXT"
    },
    "external_sources_declared": {
      "const": "NONE"
    },
    "timebox_observed_declared": {
      "enum": [
        "YES",
        "NO"
      ]
    },
    "schema_result": {
      "const": "valid"
    },
    "freshness": {
      "enum": [
        "current_for_dispatch",
        "stale_relative_to_live_state",
        "dependency_changed",
        "cannot_determine"
      ]
    },
    "security_state": {
      "const": "narrative_only_no_links_no_attachments"
    },
    "handling_state": {
      "enum": [
        "received_unadjudicated",
        "late_for_cohort",
        "ready_for_adjudication",
        "adjudicated"
      ]
    },
    "mathematical_correctness_adjudicated": {
      "const": false
    },
    "independence_strength_adjudicated": {
      "const": false
    },
    "canonical_claim_effect": {
      "const": false
    },
    "recorded_by": {
      "const": "github-actions:ns-ci-independent-contribution-intake"
    }
  }
}
