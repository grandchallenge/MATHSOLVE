{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/pilots/ns-ci-independent-contribution-metadata.schema.json",
  "title": "NS-CI pilot Independent Contribution Record metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contribution_id",
    "dispatch_id",
    "assignment_id",
    "concurrency_mode",
    "contributor_declared_identity",
    "declared_context_class",
    "prior_campaign_knowledge_used",
    "external_sources_or_tools",
    "wall_clock_limit_minutes",
    "completed_within_limit",
    "disposition",
    "raw_artifact_path",
    "raw_sha256",
    "attachments"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1-pilot"
    },
    "contribution_id": {
      "type": "string",
      "minLength": 1
    },
    "dispatch_id": {
      "type": "string",
      "minLength": 1
    },
    "assignment_id": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ]
    },
    "concurrency_mode": {
      "enum": [
        "independent_blind",
        "cooperative_claimed",
        "adversarial_replay"
      ]
    },
    "contributor_declared_identity": {
      "type": "string",
      "minLength": 1
    },
    "declared_context_class": {
      "enum": [
        "declared_zero_context",
        "declared_additional_context"
      ]
    },
    "prior_campaign_knowledge_used": {
      "type": "boolean"
    },
    "external_sources_or_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "wall_clock_limit_minutes": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 22
    },
    "completed_within_limit": {
      "type": "boolean"
    },
    "disposition": {
      "enum": [
        "PROVED",
        "REFUTED",
        "REDUCED",
        "BLOCKED"
      ]
    },
    "raw_artifact_path": {
      "type": "string",
      "minLength": 1
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256",
          "media_type",
          "executable"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
