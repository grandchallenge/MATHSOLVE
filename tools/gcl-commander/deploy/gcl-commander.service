[Unit]
Description=GCL Commander MCP on CHAD (loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/gcl-commander
Environment=GCL_COMMANDER_TRANSPORT=http
Environment=GCL_COMMANDER_PORT=8765
Environment=GCL_COMMANDER_GITHUB_ACTOR=fyremael
# Project mutation remains opt-in, disabled unless separately enabled.
Environment=GCL_COMMANDER_PROJECT_WRITE=disabled
ExecStart=%h/gcl-commander/.venv/bin/gcl-commander serve
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/gcl-commander
# gh reads existing ~/.config/gh; no API tokens placed in service file.

[Install]
WantedBy=default.target
