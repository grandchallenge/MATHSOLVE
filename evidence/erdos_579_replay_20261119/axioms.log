theorem Bounty.target : ¬(True ↔
    ∀ (δ : ℝ),
      0 < δ →
        ∃ c,
          0 < c ∧
            ∀ᶠ (n : ℕ) in Filter.atTop,
              ∀ (G : SimpleGraph (Fin n)),
                Erdos579.octahedron.Free G → δ * ↑n ^ 2 ≤ ↑G.edgeFinset.card → c * ↑n ≤ ↑G.indepNum) :=
fun h => Er579.not_positiveDensityClaim (h.mp True.intro)
